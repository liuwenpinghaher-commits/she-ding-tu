# ==============================================================================
# 设定图 (She-Ding-Tu) 环境变量示例配置 / Environment Variables Example
# 复制本文件为 .env 进行本地配置：cp .env.example .env
# 请勿将包含真实密钥的 .env 或 .env.local 提交至 Git 仓库。
# ==============================================================================

# --- 1. 后端服务与存储配置 (Rust Axum + SurrealDB) ---
# setting-api 监听地址（默认 127.0.0.1:8787）
SETTING_BIND=127.0.0.1:8787

# 书目与双时态世界库存储目录（默认 ./data/books）
SETTING_DATA=./data/books

# 前端构建产物静态目录（默认指向 apps/web/dist）
# SETTING_WEB_DIR=./apps/web/dist

# 开发模式下可将未命中 API 的请求反向代理至 Vite 开发服务器
# SETTING_WEB_DEV=http://127.0.0.1:5173

# --- 2. 前端开发与 E2E 测试配置 (Vite + Playwright) ---
# Vite 开发服务器端口与后端 API 代理地址
VITE_PORT=5173
SETTING_API_URL=http://127.0.0.1:8787

# Playwright E2E 测试目标地址
SETTING_URL=http://127.0.0.1:8787

# --- 3. 模型协作填场配置 (OpenAI 兼容接口，可选) ---
# 产品内「讨论格子 / 模型填下一场 / 丢草稿拆场 / 拼章」使用的 OpenAI 兼容接口。
# 未配置真实 API Key 时：确定性假模型填场（fill-fake）及全部核心设定/排戏功能仍可正常使用；
# 真实调用「模型填下一场（fill-live）」将明确提示缺少密钥。
SETTING_LLM_BASE_URL=
SETTING_LLM_MODEL=qwen3.8-flash
SETTING_LLM_API_KEY=
